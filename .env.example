# ---- Next.js / scripts 側（サーバー側のみで参照。画面には出さない） ----
# J-Quants API V2 のAPIキー（ダッシュボード「API Keys」で発行）
JQUANTS_API_KEY=
# 契約プラン: free | light | standard | premium（取得可能期間の計算に使う）
JQUANTS_PLAN=free
# 1分あたりのリクエスト上限（Free=5, Light=60, Standard=120, Premium=500）
JQUANTS_RATE_LIMIT_PER_MIN=5
# /v2/fins/summary 専用枠（プランに関わらず 60/分）
JQUANTS_FINS_RATE_LIMIT_PER_MIN=60
# SQLite ファイルの場所（相対パスはリポジトリルート基準）
YORI_DB_PATH=./data/db/yori-lab.sqlite
