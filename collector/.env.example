# ---- collector 専用（Next.js 側からは読まない） ----
# kabuステーションの「APIシステム設定」で設定したAPIパスワード
KABU_API_PASSWORD=
# 本番: http://localhost:18080/kabusapi  検証用: http://localhost:18081/kabusapi
KABU_API_BASE_URL=http://localhost:18080/kabusapi
KABU_WS_URL=ws://localhost:18080/kabusapi/websocket
# 記録時間帯（JST）
COLLECTOR_START=08:00
COLLECTOR_END=09:30
# 保存する板の深さ（最大10）
COLLECTOR_BOARD_DEPTH=10
# 板スナップショットの間引き間隔（ms）。0 なら変化時のみ保存
COLLECTOR_SNAPSHOT_INTERVAL_MS=1000
# 購読銘柄リスト（カンマ区切り、最大50）。空なら data/universe.json の先頭から
COLLECTOR_SYMBOLS=
YORI_DB_PATH=../data/db/yori-lab.sqlite
# 日足確定（REST で板を取得して自前日足を保存）の時刻
COLLECTOR_DAILY_BAR_AT=15:40
# 受信が途切れたとみなす秒数（欠損区間として記録）
COLLECTOR_IDLE_GAP_SEC=15
# 購読上限（kabu は 50）
COLLECTOR_MAX_SYMBOLS=50
# プロバイダ: kabu | mock
COLLECTOR_PROVIDER=kabu
