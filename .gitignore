# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!collector/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# yori-lab: 収集データ・DB・ログはgitに含めない
/data/db/
/data/archive/
/logs/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.parquet
/collector/.env
/data/subscriptions/
